# EduTrack Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to Git.

# Supabase project URL (found in your Supabase project settings)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/publishable key (safe to expose in frontend)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# NOTE: The Supabase service-role key must NEVER be placed here.
# It is used only in Supabase Edge Functions via their secure environment.
